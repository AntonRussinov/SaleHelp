# IDE Settings
/.vscode

# Local config
/configs/config.yml
/configs/config.prod.yml
/configs/config-local.yml
/configs/local.env
/configs/local-certificates/
/certs/*

# Mac OS X files
.DS_Store

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

# Output for generated files related to CI/CD
data/*

# Private planning and documentation (not for commit)
/_private/


# Local environment / secrets
.env
.env.*
!.env.example
*.local

# Local build output
/bin/
/salehelp
/main
coverage.out
coverage.html
