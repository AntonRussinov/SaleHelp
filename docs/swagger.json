        "/v1/shops/{shopId}/products": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Список товаров по shopId. Проверка доступа по JWT. Query: limit, offset",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "shops"
                ],
                "summary": "Товары магазина",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID магазина",
                        "name": "shopId",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "default": 20,
                        "description": "Лимит",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 0,
                        "description": "Смещение",
                        "name": "offset",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "items, total, limit, offset",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/api.HTTPError"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/api.HTTPError"
                        }
                    }
                }
            }
        },
        "/v1/telegram/webhook": {
            "post": {
                "description": "Принимает Update от Telegram Bot API. Опционально проверяет заголовок X-Telegram-Bot-Api-Secret-Token.",
                "consumes": [
                    "application/json"
                ],
                "tags": [
                    "telegram"
                ],
                "summary": "Telegram webhook",
                "parameters": [
                    {
                        "description": "Telegram Update (JSON)",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "object"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    },
                    "400": {
                        "description": "Bad Request"
                    },
                    "403": {
                        "description": "Forbidden"
                    }
