# Environment variables read by the app (see internal/config/config.go and
# internal/app/di/services.go). The app does NOT load .env files itself;
# export them in your shell, e.g.:  set -a; source .env; set +a
# Every value here is a placeholder. Never commit a real .env.

# PostgreSQL DSN (overrides service.db.connstring). Also used by `make migrate-*`.
DATABASE_URL=postgres://salehelp:salehelp@localhost:5432/salehelp?sslmode=disable

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=000000000:replace-with-your-bot-token

# Secret used to sign JWTs issued by the API. Use a long random string.
JWT_SECRET=replace-with-a-long-random-string

# Google OAuth2 Client ID (optional; enables Google sign-in).
GOOGLE_CLIENT_ID=replace-with-your-client-id.apps.googleusercontent.com

# OpenAI API key (optional; without it AI replies are disabled).
OPENAI_API_KEY=sk-replace-me

# Wildberries service secret sent as X-Client-Secret (optional).
WB_X_CLIENT_SECRET=

# Optional: worker id used by background workers (default: hostname).
WORKER_ID=
